{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "blue": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.078,
          0.388,
          1
        ],
        "alpha": 1
      }
    },
    "action": {
      "$type": "color",
      "$value": "{color.blue}"
    }
  },
  "radius": {
    "button": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      }
    }
  }
}

{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "brand": {
      "$type": "color",
      "$value": {"colorSpace": "srgb", "components": [0.078, 0.388, 1], "alpha": 1}
    },
    "action": {
      "$type": "color",
      "$value": "{color.brand}"
    }
  },
  "space": {
    "control": {
      "$type": "dimension",
      "$value": {"value": 8, "unit": "px"}
    }
  }
}

package interchangeadoption
namespace designevidenceinterchange

entity ReleasedGoooIdentity id "design://interchange/entity/released-gooo-identity"
entity InterchangeReleaseIdentity id "design://interchange/entity/interchange-release-identity"
entity DesignEvidenceAuthority id "design://interchange/entity/design-evidence-authority"
entity AdoptionState id "design://interchange/entity/adoption-state"
entity FiveFileEnvelope id "design://interchange/entity/five-file-envelope"
entity AdvisoryBundle id "design://interchange/entity/advisory-bundle"
entity LocalConformance id "design://interchange/entity/local-conformance"
entity RelationMatch id "design://interchange/entity/relation-match"
entity ReplayObservation id "design://interchange/entity/replay-observation"
entity UnknownTupleGuard id "design://interchange/entity/unknown-tuple-guard"
entity ChecksumDriftGuard id "design://interchange/entity/checksum-drift-guard"
entity IndependentReadOnlyEffect id "design://interchange/entity/independent-read-only-effect"
entity AdoptionDecision id "design://interchange/entity/adoption-decision"

activity ObserveReleasedGoooIdentity(ReleasedGoooIdentity) -> AdoptionDecision
activity ObserveInterchangeReleaseIdentity(InterchangeReleaseIdentity) -> AdoptionDecision
activity DeclareDesignEvidenceAuthority(DesignEvidenceAuthority) -> AdoptionDecision
activity ObserveAdoptionState(AdoptionState) -> AdoptionDecision
activity DefineFiveFileEnvelope(FiveFileEnvelope) -> AdoptionDecision
activity GenerateAdvisoryBundle(AdvisoryBundle) -> AdoptionDecision
activity ConformSixLocalChecks(LocalConformance) -> AdoptionDecision
activity ObserveRelationMatch(RelationMatch) -> AdoptionDecision
activity ObserveDeterministicReplay(ReplayObservation) -> AdoptionDecision
activity PreserveUnknownTuple(UnknownTupleGuard) -> AdoptionDecision
activity RejectChecksumDrift(ChecksumDriftGuard) -> AdoptionDecision
activity PreserveIndependentReadOnlyEffect(IndependentReadOnlyEffect) -> AdoptionDecision
